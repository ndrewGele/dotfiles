# Theme
{%@@ if ghostty_theme @@%}
theme = {{@@ ghostty_theme @@}}
{%@@ endif @@%}

# Font configuration
font-family = "Victor Mono"
font-size = 14

# Enable font ligatures (Victor Mono has nice coding ligatures)
font-feature = liga
font-feature = calt

# Super+Backspace: kill entire line (sends Ctrl+U)
keybind = super+backspace=text:\x15
